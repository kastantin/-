{
  "name": "ai-cartoon-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Локальная студия коротких 2D-мультфильмов на Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:test": "remotion render src/index.ts StudioTest D:/Скатерть/renders/studio-test.mp4 --codec=h264",
    "still:test": "remotion still src/index.ts StudioTest D:/Скатерть/renders/studio-test.png --frame=45",
    "render:ep01": "remotion render src/index.ts Episode01 D:/Скатерть/renders/ep01_pogovorim.mp4 --codec=h264",
    "render:ep02": "remotion render src/index.ts Episode02 D:/Скатерть/renders/ep02_nol_golosov.mp4 --codec=h264",
    "render:ep03": "remotion render src/index.ts Episode03 D:/Скатерть/renders/ep03_druzya.mp4 --codec=h264",
    "render:ep04": "remotion render src/index.ts Episode04 D:/Скатерть/renders/ep04_holodnaya_vojna.mp4 --codec=h264",
    "render:ep05": "remotion render src/index.ts Episode05 D:/Скатерть/renders/ep05_druzhba_druzhboj.mp4 --codec=h264",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
