# Скопируй этот файл в .env и впиши токен от BotFather.
# Файл .env никому не отправляй — в нём ключ от бота.

# Токен от BotFather (обязательно)
BOT_TOKEN=

# Твой Telegram ID — узнай командой /id в личке у бота. Нужен для команды /ideas.
ADMIN_ID=

# Последняя вышедшая серия. Идеи собираются для следующей.
CURRENT_EPISODE=1

# Можно не трогать
CHANNEL_USERNAME=obshchepit_yama
TIKTOK_URL=https://www.tiktok.com/@vyzhivi_v_obshepite
